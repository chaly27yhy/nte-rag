# ============================================================
# 开发期专用配置模板
#
# 用法：复制为 .env 并填入自己的 Key。
#   .env 已被 .gitignore 忽略，且被 tools/build_exe.ps1 强制排除；
#   tools/secret_scan.py 会在打包前扫描，发现真实 Key 就中止构建。
#
# 最终用户不需要这个文件：他们通过界面（设置页）填写自己的 Key，
# Key 以 Windows DPAPI 加密后保存在本机。
#
# 变量名统一为 NTE_RAG_* 前缀；名字与读取规则集中在 app/core/env.py。
# ============================================================

# ------------------------------------------------------------
# 总开关：不写这一行，下面所有 NTE_RAG_DEV_* 都不会生效。
# 这道闸门避免源码检出与便携分发被 .env 顶掉界面上填好的模型与 Key：
# 旧行为会直接覆盖并写回 config.json，界面上没有任何提示。
# 密钥字段只在当前为空时填入，不覆盖已保存的 Key。
# tools/ 下的开发脚本（run_eval / live_check / kb_probe / seed_builder /
# build_eval_set）属于开发用途，直接传 explicit=True 跳过这道闸门。
# ------------------------------------------------------------
NTE_RAG_DEV_ENV=1

# 开发联调用的模型 API（仅本机使用，不会进入 exe）
NTE_RAG_DEV_LLM_PROVIDER=openai
NTE_RAG_DEV_LLM_BASE_URL=
NTE_RAG_DEV_LLM_API_KEY=
NTE_RAG_DEV_LLM_MODEL=

# 开发联调用的搜索 API（博查）
NTE_RAG_DEV_SEARCH_PROVIDER=bocha
NTE_RAG_DEV_SEARCH_API_KEY=

# 进程级开关（通常不需要改）：
#   NTE_RAG_DATA_DIR=...     指定数据目录（优先级最高）
#   NTE_RAG_PORTABLE=1       强制便携模式；=0 强制 %APPDATA% 模式
#   NTE_RAG_DISABLE_AUTH=1   关闭接口鉴权，仅用于自动化测试
